# Yerel geliştirme için .env olarak kopyala. .env repoya girmez.
SECRET_KEY=change-me
DATABASE_URL=postgres://rapidquiz:rapidquiz@localhost:5432/rapidquiz
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# İstemci IP'sinin okunacağı güvenilir vekil sayısı (throttle ve ip_hash için).
# Yerelde 0; prodüksiyonda varsayılan 1, ilk deploy'da doğrulanmalı.
NUM_PROXIES=0

# Skor şişirme önlemi: soru başına ortalama cevap süresi (ms) bunun altındaysa skor
# kaydedilmez. Tüm ortamlarda aynı bırak; 0 kapatır.
SCORE_MIN_AVG_RESPONSE_MS=500

# Prodüksiyon (DigitalOcean App Platform panelinden girilir):
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=api.rapidquiz.example.com
# CSRF_TRUSTED_ORIGINS=https://api.rapidquiz.example.com
# ADMIN_URL=gizli-yonetim-yolu/
